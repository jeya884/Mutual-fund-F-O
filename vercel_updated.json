{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/yahoo/:symbol", "destination": "https://query1.finance.yahoo.com/v8/finance/chart/:symbol" },
    { "source": "/api/amfi/nav", "destination": "https://portal.amfiindia.com/spages/NAVAll.txt" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
